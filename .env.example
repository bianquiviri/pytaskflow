# TaskFlow environment template — copy to .env and adjust.
# Never commit real secrets. Values here are safe development placeholders.

# --- General ---
ENVIRONMENT=development
SECRET_KEY=dev-only-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (Docker service "db") ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow-dev-password
DATABASE_URL=postgres://taskflow:taskflow-dev-password@db:5432/taskflow

# Backend database settings used by Django when running outside Docker:
# DB_PORT_HOST controls the host port published by the compose db service
# (change it if 5432 is already used on this machine). DB_PORT is what Django
# uses when running directly on the host (inside Docker the backend always
# uses db:5432).
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow-dev-password
DB_HOST=localhost
DB_PORT=5432
DB_PORT_HOST=5432

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Host port for the Vite dev server container (change if 5173 is taken):
FRONTEND_PORT=5173

# --- Demo seeders (development defaults; NEVER reuse in production) ---
SEED_DEMO_PASSWORD=demo-password-123
SEED_CONFIRM_DESTRUCTIVE=yes
